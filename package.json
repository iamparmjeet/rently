{
	"name": "rently",
	"version": "0.1.0-beta.3",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/bun": "^1.3.4",
			"hono": "^4.8.2",
			"@orpc/server": "^1.13.14",
			"@orpc/openapi": "^1.13.14",
			"@orpc/zod": "^1.13.14",
			"better-auth": "1.6.9",
			"evlog": "^2.14.1",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.3",
			"react-dom": "^19.2.3",
			"sonner": "^2.0.5",
			"@orpc/client": "^1.13.14",
			"@types/react": "^19.2.10",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "DATABASE_URL=postgresql://rently_db_user:rently_db_password@localhost:5432/rently_dev USE_NEON=false NODE_ENV=development turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:dashboard": "turbo -F dashboard dev",
		"dev:admin": "turbo -F admin dev",
		"dev:tenant": "turbo -F tenant dev",
		"dev:server:local-db": "DATABASE_URL=postgresql://rently_db_user:rently_db_password@localhost:5432/rently_dev USE_NEON=false NODE_ENV=development bun run --cwd apps/server dev",
		"build:admin": "turbo -F admin build",
		"build:dashboard": "turbo -F dashboard build",
		"build:tenant": "turbo -F tenant build",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @rently/db db:push",
		"db:studio": "turbo -F @rently/db db:studio",
		"db:studio:local": "turbo -F @rently/db db:studio:local",
		"db:generate": "turbo -F @rently/db db:generate",
		"db:migrate:local": "turbo -F @rently/db db:migrate:local",
		"db:migrate": "turbo -F @rently/db db:migrate",
		"db:migrate:test": "turbo -F @rently/db db:migrate:test",
		"db:refresh:local": "bash scripts/refresh-neon-to-local.sh",
		"db:seed": "turbo -F @rently/db db:seed",
		"db:seed:local": "turbo -F @rently/db db:seed:local",
		"db:seed-demo": "bun run --env-file=apps/server/.env apps/server/src/seed-demo.ts",
		"db:beta-codes": "bun run @rently/db db:beta-codes",
		"check": "biome check --write .",
		"release": "release-it",
		"release:beta": "release-it --preRelease=beta",
		"test": "vitest run"
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.1.21",
		"@orpc/tanstack-query": "^1.14.4",
		"@rently/env": "workspace:*",
		"@types/node": "^25.9.1",
		"dev": "^0.1.5",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@release-it/conventional-changelog": "^11.0.1",
		"@rently/config": "workspace:*",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/bun": "^1.3.14",
		"dotenv": "^17.4.2",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.9",
		"release-it": "^20.2.0",
		"turbo": "^2.9.16",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "bun@1.3.13"
}
