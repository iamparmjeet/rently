// apps/server/wrangler.jsonc
{
  "name": "rently-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-04",
  // nodejs_compat — Better Auth uses Node.js crypto APIs internally.
  // Without this flag, the Worker crashes on auth operations.
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // these mirror your @rently/env/server schema exactly.
  // Secrets (API keys, DB URLs) are set via `wrangler secret put` or
  // the Cloudflare dashboard — never in this file.
  "vars": {
    "NODE_ENV": "production",
    "USE_NEON": "true"
  }
}
